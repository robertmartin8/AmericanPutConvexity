{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lean: build project",
      "type": "shell",
      "command": "lake build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lean: check current file",
      "type": "shell",
      "command": "lake",
      "args": ["env", "lean", "-DwarningAsError=true", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Lean: fetch Mathlib cache",
      "type": "shell",
      "command": "lake exe cache get",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
